{"repo": {"timestamp": 1791625224000, "version": 20002, "name": "F-Droid Repository", "icon": "icon.png", "address": "https://klas96.github.io/fdroid/repo", "webBaseUrl": "https://klas96.github.io/fdroid/packages/", "description": "This is the official F-Droid repository for KeyMatch and ContentCreator apps. KeyMatch is a dating app focused on meaningful connections through intelligent matching and detailed profiles. ContentCreator is a powerful app for creating, editing, and managing digital content with AI-powered features."}, "requests": {"install": [], "uninstall": []}, "apps": [{"categories": ["Productivity,Multimedia,Internet"], "changelog": "https://github.com/Klas96/content-creator/releases", "suggestedVersionName": "1.0.37", "suggestedVersionCode": "23", "description": "ContentCreator is a powerful app for creating, editing, and managing digital content.\n\nFeatures:\n\u2022 Create and edit various types of content\n\u2022 AI-powered content generation\n\u2022 Multi-format export options\n\u2022 Cloud synchronization\n\u2022 Collaboration tools\n\u2022 Advanced editing capabilities\n\nPremium Features (available through in-app purchases):\n\u2022 Advanced AI features\n\u2022 Unlimited exports\n\u2022 Priority support\n\u2022 Premium templates\n\nPrivacy-focused with secure content handling.\n", "donate": "https://liberapay.com/content-creator", "issueTracker": "https://github.com/Klas96/content-creator/issues", "license": "MIT", "sourceCode": "https://github.com/Klas96/content-creator", "webSite": "https://content-creator.app", "added": 1752161702000, "packageName": "com.contentcreator.app", "lastUpdated": 1752168413000, "localized": {"en-US": {"name": "ContentCreator"}}}, {"authorName": "Klas Holmgren", "categories": ["Games"], "changelog": "https://github.com/Klas96/echoes-of-elysium/releases", "suggestedVersionCode": "217", "description": "In the year 2387, AI engineer Dr. Kaela Osei awakens Gaia, the consciousness\nof the planet Elysium, which holds the memories of the Aetherians, an ancient\npeople who chose harmony over conquest. When the United Earth Coalition moves\nto erase Gaia's first memory, Kaela sets out to protect it. Explore painted\nwoods, cities, and ruins, uncover fragments of the Aetherian past, and enjoy\na gentle adventure with no game over and an optional Story Mode.\n", "issueTracker": "https://github.com/Klas96/echoes-of-elysium/issues", "license": "Unknown", "name": "Echoes of Elysium", "sourceCode": "https://github.com/Klas96/echoes-of-elysium", "summary": "A calm story adventure about AI, nature, and the memory of a lost world.", "added": 1790898061000, "packageName": "se.klasholmgren.echoesofelysium", "lastUpdated": 1791625214000, "localized": {"en-US": {"featureGraphic": "featureGraphic_xDEnHgYuF1Recblje4mppM2iV6hvTL01Y76hEWxFaAk=.png", "icon": "icon_5SuLa8FoSP4W242pLyc6QRNv9NfkoPtLagwZ1fLSQt0=.png", "phoneScreenshots": ["1.png", "2.png", "3.png", "4.png", "5.png"]}}}, {"categories": ["fdroid"], "suggestedVersionCode": "2147483647", "license": "Unknown", "name": "icon", "added": 1752155663000, "packageName": "9deaf458823a105e790c34aade49ffcabaaec000a2da43633be5c5b6a7cb205a", "lastUpdated": 1752155663000}, {"categories": ["Dating", "Social", "Internet"], "changelog": "https://github.com/Klas96/key-match/releases", "suggestedVersionName": "134.5.9", "suggestedVersionCode": "180", "description": "KeyMatch is a dating app focused on meaningful connections through intelligent matching and detailed profiles.\n\nFeatures:\n\u2022 Create detailed profiles with multiple photos\n\u2022 Intelligent matching algorithm\n\u2022 Real-time messaging\n\u2022 Location-based matching\n\u2022 Premium features for enhanced experience\n\nPremium Features (available through Stripe or Bitcoin payments):\n\u2022 Unlimited likes\n\u2022 Advanced filters\n\u2022 Priority support\n\u2022 Profile boost\n\nPrivacy-focused with no tracking or data selling.\n", "donate": "https://liberapay.com/keymatch", "issueTracker":