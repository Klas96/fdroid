{"repo": {"timestamp": 1792151878000, "version": 20002, "name": "F-Droid Repository", "icon": "icon.png", "address": "https://klas96.github.io/fdroid/repo", "webBaseUrl": "https://klas96.github.io/fdroid/packages/", "description": "This is the official F-Droid repository for Klas Holmgren's Android apps, including KeyMatch, mooves, NumBlocks, and Echoes of Elysium."}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorName": "Klas Holmgren", "categories": ["Games"], "changelog": "https://github.com/Klas96/echoes-of-elysium/releases", "suggestedVersionCode": "305", "description": "In the year 2387, AI engineer Dr. Kaela Osei awakens Gaia, the consciousness\nof the planet Elysium, which holds the memories of the Aetherians, an ancient\npeople who chose harmony over conquest. When the United Earth Coalition moves\nto erase Gaia's first memory, Kaela sets out to protect it. Explore painted\nwoods, cities, and ruins, uncover fragments of the Aetherian past, and enjoy\na gentle adventure with no game over and an optional Story Mode.\n", "issueTracker": "https://github.com/Klas96/echoes-of-elysium/issues", "license": "Unknown", "name": "Echoes of Elysium", "sourceCode": "https://github.com/Klas96/echoes-of-elysium", "summary": "A calm story adventure about AI, nature, and the memory of a lost world.", "added": 1790898061000, "packageName": "se.klasholmgren.echoesofelysium", "lastUpdated": 1792000439000, "localized": {"en-US": {"featureGraphic": "featureGraphic_xDEnHgYuF1Recblje4mppM2iV6hvTL01Y76hEWxFaAk=.png", "icon": "icon_5SuLa8FoSP4W242pLyc6QRNv9NfkoPtLagwZ1fLSQt0=.png", "phoneScreenshots": ["1.png", "2.png", "3.png", "4.png", "5.png"]}}}, {"authorName": "Klas Holmgren", "categories": ["Games", "Science & Education"], "changelog": "https://github.com/Klas96/languagegame/releases", "suggestedVersionCode": "10003", "description": "First Words helps young learners pick up new words with interactive flash\ncards that combine text, images, and sounds.\n\nCreate custom cards: add text, pick or take photos, record or choose audio.\nBrowse a kid-friendly grid, swipe full-screen, and play each card's sound.\nEverything stays on the device \u2014 no account, no tracking, and core learning\nworks offline.\n\nFree version includes a card limit; a one-time premium unlock removes it.\n", "issueTracker": "https://github.com/Klas96/languagegame/issues", "license": "Unknown", "name": "First Words", "sourceCode": "https://github.com/Klas96/languagegame", "summary": "Learn words with interactive flash cards \u2014 images, sounds, and text for kids.", "added": 1792151873000, "packageName": "com.firstwords.app", "lastUpdated": 1792151873000, "localized": {"en-US": {"featureGraphic": "featureGraphic_lrF7vg7prHPM3MKTsIwzR7T3JOam5Z6V2Vr1eKYcydc=.png", "icon": "icon_Xb7o33gD4pGWV8zt6mCBxGnaNR8HkV52xIIJSJi_BzY=.png", "phoneScreenshots": ["1.png", "2.png", "3.png"]}}}, {"categories": ["Dating", "Social", "Internet"], "changelog": "https://github.com/Klas96/KeyMatch-App/releases", "suggestedVersionName": "134.10.26", "suggestedVersionCode": "276", "description": "KeyMatch is a dating app focused on meaningful connections through intelligent matching and detailed profiles.\n\nFeatures:\n\u2022 Create detailed profiles with multiple photos\n\u2022 Intelligent matching algorithm\n\u2022 Real-time messaging\n\u2022 Location-based matching\n\u2022 Premium features for enhanced experience\n\nPremium purchases and premium unlocks are not available in this build.\nFirebase and Google Sign-In stay included.\n\nPrivacy-focused with no tracking or data selling.\n", "donate": "https://liberapay.com/keymatch", "issueTracker": "https://github.com/Klas96/KeyMatch-App/issues", "license": "MIT", "name": "KeyMatch", "sourceCode": "https://github.com/Klas96/KeyMatch-App", "webSite": "https://keymatch.app", "added": 1752152099000, "packageName": "com.keymatch.app", "lastUpdated": 1792149367000, "localized": {"en-US": {"featureGraphic": "featureGraphic_Qp4KKk78w6IUNY